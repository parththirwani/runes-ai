DATABASE_URL=
NODE_ENV=
NEXT_PUBLIC_APP_URL=

NEXTAUTH_URL=
NEXTAUTH_SECRET=

AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

WORKER_PORT=

REDIS_HOST=
REDIS_PORT=
REDIS_PASSWORD=
REDIS_DB=

OPENROUTER_API_KEY=
DEV_AUTH_BYPASS=

# --- compile engine ---
# direct: run Tectonic inside the isolated worker image (default in Dockerfile.worker)
# docker-exec: reuse the warm TECTONIC_CONTAINER_NAME container
# docker-run: start a throwaway container per job (slowest, most isolated)
TECTONIC_ENGINE=direct
TECTONIC_BINARY=tectonic
TECTONIC_IMAGE=dxjoke/tectonic-docker:latest
TECTONIC_CONTAINER_NAME=
# Persistent package cache. A cold cache downloads ~40 MB (measured 88 s) versus ~0.4 s warm.
TECTONIC_CACHE_DIR=
# 1 = fail instead of downloading packages when the cache misses
TECTONIC_OFFLINE=
TECTONIC_KEEP_INTERMEDIATES=

# --- worker capacity and limits ---
WORKER_CONCURRENCY=2
COMPILE_TIMEOUT_MS=90000
COMPILER_MEMORY_LIMIT=1g
COMPILER_CPU_LIMIT=2

# --- storage ---
# local is the only implemented driver; s3 must be added before it can be used
STORAGE_DRIVER=local
ASSET_STORAGE_DIR=
# never point this inside the project tree
COMPILE_TMP_DIR=
