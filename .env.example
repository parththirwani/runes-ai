DATABASE_URL=
NODE_ENV=
NEXT_PUBLIC_APP_URL=

NEXTAUTH_URL=
NEXTAUTH_SECRET=

AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

WORKER_PORT=

REDIS_HOST=
REDIS_PORT=
REDIS_PASSWORD=
REDIS_DB=

OPENROUTER_API_KEY=
DEV_AUTH_BYPASS=

# Markdown compilation (worker). Binaries must exist on the worker host.
PANDOC_BIN=
PDF_ENGINE_BIN=

# Optional: run LaTeX compiles with a local tectonic binary instead of the
# docker sibling container (leave unset to keep docker-based LaTeX compiles).
TECTONIC_BINARY=

# Markdown compiler isolation (worker).
# COMPILER_UNSHARE_BIN: path to util-linux unshare (default /usr/bin/unshare).
# COMPILER_REQUIRE_NETNS=1: fail compiles when a private network namespace
# cannot be created, instead of running Pandoc with network access.
COMPILER_UNSHARE_BIN=
COMPILER_REQUIRE_NETNS=
