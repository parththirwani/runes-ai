generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  firstName String?
  lastName  String?
  image     String?  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  documents Document[]

  @@map("users")
}

model Document {
  id        String         @id @default(uuid())
  title     String         @unique
  content   String         @db.Text // LaTeX or Markdown source, per format
  format    DocumentFormat @default(LATEX) // immutable after creation
  slug      String         @unique
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  chatSessions ChatSession[]
  assets       DocumentAsset[]

  @@unique([userId, title])
  @@index([userId])
  @@map("documents")
}

// Owned local image assets for Markdown documents. Normalized relative paths
// map directly onto the planned workspace file model
// (compile-workspace-plan.md: file rows keyed by (documentId, normalizedPath)).
model DocumentAsset {
  id         String   @id @default(uuid())
  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  path       String // normalized relative path, e.g. "images/diagram.png"
  mediaType  String
  size       Int
  checksum   String // hex sha256 of bytes
  bytes      Bytes
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([documentId, path])
  @@index([documentId])
  @@map("document_assets")
}

enum DocumentFormat {
  LATEX
  MARKDOWN
}

model ChatSession {
  id         String   @id @default(uuid())
  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  title      String?  
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  messages Message[]

  @@index([documentId])
  @@map("chat_sessions")
}

model Message {
  id            String      @id @default(uuid())
  chatSessionId String
  chatSession   ChatSession @relation(fields: [chatSessionId], references: [id], onDelete: Cascade)
  content       String      @db.Text
  role          MessageRole // 'user' or 'assistant'
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([chatSessionId])
  @@map("messages")
}

enum MessageRole {
  user
  assistant
}