generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  firstName String?
  lastName  String?
  image     String?  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  documents Document[]

  @@map("users")
}

model Document {
  id           String  @id @default(uuid())
  title        String  @unique
  // Legacy single-source column. Kept in sync with the main file so existing URLs,
  // clients and rollbacks keep working until the column is explicitly dropped.
  content      String? @db.Text
  mainFilePath String  @default("main.tex")
  slug         String  @unique
  userId       String
  user         User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  chatSessions ChatSession[]
  files        WorkspaceFile[]

  @@unique([userId, title])
  @@index([userId])
  @@map("documents")
}

// One file inside a workspace. Directory structure is derived from `path`, which is
// always a normalized POSIX relative path such as "chapters/methods.tex".
model WorkspaceFile {
  id         String      @id @default(uuid())
  documentId String
  document   Document    @relation(fields: [documentId], references: [id], onDelete: Cascade)
  path       String
  kind       WorkspaceFileKind
  mimeType   String?
  sizeBytes  Int         @default(0)
  checksum   String      @default("")
  revision   Int         @default(1)
  content    String?     @db.Text
  storageKey String?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@unique([documentId, path])
  @@index([documentId])
  @@map("workspace_files")
}

enum WorkspaceFileKind {
  tex
  bib
  image
  other
}

model ChatSession {
  id         String   @id @default(uuid())
  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  title      String?  
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  messages Message[]

  @@index([documentId])
  @@map("chat_sessions")
}

model Message {
  id            String      @id @default(uuid())
  chatSessionId String
  chatSession   ChatSession @relation(fields: [chatSessionId], references: [id], onDelete: Cascade)
  content       String      @db.Text
  role          MessageRole // 'user' or 'assistant'
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([chatSessionId])
  @@map("messages")
}

enum MessageRole {
  user
  assistant
}